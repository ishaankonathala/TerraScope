# ==============================================================================
# Satellite Land-Use Monitoring Configuration (.env.example)
# Copy to .env and adjust values as needed. No credentials are required for
# local image uploads, training, evaluation, or dashboard workflows.
# ==============================================================================

# --- Application & API ---
APP_NAME=Satellite Land-Use Monitoring
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Compute & Model Settings ---
# Options: auto, cpu, mps, cuda
DEVICE=auto
DEFAULT_IMAGE_SIZE=256
MAX_UPLOAD_SIZE_MB=50
ALLOW_PRETRAINED_DOWNLOAD=true

# --- Storage Paths (relative to project root or absolute) ---
DATA_DIR=data
MODELS_DIR=models/checkpoints
EXPERIMENTS_DIR=experiments
OUTPUTS_DIR=outputs
UPLOAD_TMP_DIR=outputs/tmp_uploads

# --- Optional Google Earth Engine (GEE) Configuration ---
# GEE is optional. Local image uploads and LEVIR-CD / OSCD datasets work
# without Earth Engine credentials or network access.
GEE_ENABLED=false
# Google Cloud Project ID registered with Earth Engine:
GEE_PROJECT_ID=
# Optional Service Account email (leave empty to use interactive `earthengine authenticate` credentials):
GEE_SERVICE_ACCOUNT=
# Optional path to local service account JSON key (never commit this file!):
GEE_PRIVATE_KEY_PATH=
# Supported export modes: local_geotiff, google_drive, gcs
GEE_EXPORT_DESTINATION=local_geotiff
GEE_DRIVE_FOLDER=satellite_change_exports
GEE_GCS_BUCKET=

