# Virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Environment variables and credentials (NEVER commit secrets)
.env
.env.local
*.pem
*.key
*credentials*.json
*service-account*.json
*service_account*.json
earthengine_credentials/

# Large datasets (keep directory READMEs)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep

# Model checkpoints
models/checkpoints/*
!models/checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors

# Experiment logs and generated outputs
experiments/logs/*
!experiments/logs/.gitkeep
outputs/change_maps/*
!outputs/change_maps/.gitkeep
outputs/attention_maps/*
!outputs/attention_maps/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/visualizations/*
!outputs/visualizations/.gitkeep
outputs/tmp_uploads/
outputs/gee_exports/
uploads/
tmp/

# OS and IDE files
.DS_Store
.vscode/
.idea/

